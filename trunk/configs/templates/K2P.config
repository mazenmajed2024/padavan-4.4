### Target Vendor/Product
CONFIG_VENDOR=Ralink
CONFIG_PRODUCT=MT7621

### Target ProductID
CONFIG_FIRMWARE_PRODUCT_ID="K2P"

### Linux Kernel & Toolchain
CONFIG_LINUXDIR=linux-4.4.x
CONFIG_TOOLCHAIN_DIR=/opt/rt-n56u/toolchain-mipsel/toolchain-4.4.x

### Flash & Memory Size (16MB SPI Flash)
CONFIG_FIRMWARE_TYPE_ROOTFS_IN_RAM=y
CONFIG_FIRMWARE_ROOTFS_IN_RAM_SIZE=32768
CONFIG_FIRMWARE_ENABLE_SQUASHFS=y
CONFIG_FIRMWARE_TASKSET_CPU=y

### WiFi Driver (MT7615D DBDC 2.4G + 5G)
CONFIG_FIRMWARE_WIFI2_DRIVER=3.0
CONFIG_FIRMWARE_WIFI5_DRIVER=5.0
CONFIG_FIRMWARE_MT7615_DBDC=y
CONFIG_FIRMWARE_ENABLE_HWNAT=y
CONFIG_FIRMWARE_ENABLE_SFE=y

### Ethernet Switch (MT7530 Gigabit: 1 WAN + 4 LAN)
CONFIG_RAETH_GMAC2=y
CONFIG_MAC_TO_GIGAPHY_MODE_ADDR2=0x1f
CONFIG_RAETH_ESW=y

### USB & Storage (Disabled - No USB port on K2P)
# CONFIG_FIRMWARE_INCLUDE_USB is not set
# CONFIG_FIRMWARE_INCLUDE_UVC is not set
# CONFIG_FIRMWARE_INCLUDE_NTFS is not set

### Essential Services & Features
CONFIG_FIRMWARE_INCLUDE_LANG_EN=y
CONFIG_FIRMWARE_INCLUDE_SSWAN=y
CONFIG_FIRMWARE_INCLUDE_OPENVPN=y
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y
CONFIG_FIRMWARE_INCLUDE_SMARTDNS=y
CONFIG_FIRMWARE_INCLUDE_ADBYBY=n
CONFIG_FIRMWARE_INCLUDE_KMS=y
CONFIG_FIRMWARE_INCLUDE_DDNS=y
